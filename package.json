{
  "name": "flipbook",
  "version": "1.0.0-beta.7",
  "license": "MIT",
  "description": "3D page flip effect for Vue.js",
  "homepage": "https://ts1.github.io/flipbook-vue/",
  "author": "Takeshi Sone <takeshi.sone@gmail.com> (https://github.com/ts1)",
  "repository": "github:ts1/flipbook-vue",
  "keywords": [
    "vue",
    "flipbook",
    "component",
    "book",
    "page",
    "flip",
    "turn",
    "3d"
  ],
  "type": "module",
  "main": "./dist/flipbook.umd.cjs",
  "module": "./dist/flipbook.js",
  "browser": "./dist/flipbook.js",
  "types": "./types/flipbook.d.ts",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview"
  },
  "exports": {
    ".": {
      "types": "./types/flipbook.d.ts",
      "import": "./dist/flipbook.js",
      "require": "./dist/flipbook.umd.cjs",
      "default": "./dist/flipbook.js"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "vite": "^5.4.2",
    "vite-plugin-css-injected-by-js": "^3.5.1"
  },
  "peerDependencies": {
    "vue": ">=3.4.38"
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 0.25%",
    "not dead"
  ],
  "files": [
    "dist",
    "types",
    "README.md"
  ],
  "dependencies": {
    "rematrix": "^0.7.2"
  }
}
